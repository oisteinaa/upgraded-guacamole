# Copy to app.env; preserve actual production settings and credentials.
DAS_DATABASE_URL=dbname=sensnetdb user=sensnetdbu host=127.0.0.1
DAS_ARCHIVE_ROOT=/raid1
DAS_ENVIRONMENT=Server investigation
DAS_LIVE_ZMQ_BIND=tcp://0.0.0.0:12345
# Preserve independently verified live mapping/time settings from existing config.
# DAS_LIVE_LID=1
# DAS_LIVE_TIME_VERIFIED=1
# DAS_LIVE_MAPPING_VERIFIED=1
DAS_LIVE_SNAPSHOT=/app/.local/server-live.json
DAS_METRIC_CACHE=/app/.local/metric-cache
DAS_CALM_BASELINES=/app/.local/calm-baselines
DAS_REPORT_ROOT=/app/.local/reports
DAS_REVIEW_WRITES=0

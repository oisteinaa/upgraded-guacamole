[Unit]
Description=Sensnet weekly integrity report
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/home/inst/oistein/upgraded-guacamole
ExecStart=/usr/bin/bash /home/inst/oistein/upgraded-guacamole/scripts/run_reports_server.sh --weekly
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
UMask=0077
[Install]
WantedBy=default.target
